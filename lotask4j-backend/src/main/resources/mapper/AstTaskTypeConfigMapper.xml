<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fun.commons.lotask4j.mapper.AstTaskTypeConfigMapper">

    <!-- 根据 typeKey 查询任务类型配置 -->
    <!-- resultType 自动映射会丢列 (exec_timeout_sec→timeoutSeconds / type_name→name 属性名不一致),
         必须用 resultMap 显式映射 -->
    <resultMap id="BaseResultMap" type="fun.commons.lotask4j.entity.AstTaskTypeConfig">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="type_key" property="typeKey"/>
        <result column="type_name" property="name"/>
        <result column="max_concurrency" property="concurrencyLimit"/>
        <result column="max_queued" property="maxQueued"/>
        <result column="exec_timeout_sec" property="timeoutSeconds"/>
        <result column="max_retry_count" property="maxRetries"/>
        <result column="is_enabled" property="isEnabled"/>
        <result column="steps_definition" property="stepsConfig"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectByTypeKey" resultMap="BaseResultMap">
        SELECT id, tenant_id, type_key, type_name, max_concurrency, max_queued, exec_timeout_sec,
               max_retry_count, is_enabled, steps_definition, created_at, updated_at, is_deleted
        FROM asts_task_type_config
        WHERE type_key = #{typeKey}
          AND is_deleted = 0
        <if test="tenantId != null">
          AND tenant_id = #{tenantId}
        </if>
        LIMIT 1
    </select>

    <!-- 检查任务类型是否启用 -->
    <select id="isTypeEnabled" resultType="java.lang.Boolean">
        SELECT is_enabled
        FROM asts_task_type_config
        WHERE type_key = #{typeKey}
          AND is_deleted = 0
        <if test="tenantId != null">
          AND tenant_id = #{tenantId}
        </if>
        LIMIT 1
    </select>

    <!-- 获取任务类型的并发限制 -->
    <select id="getConcurrencyLimit" resultType="java.lang.Integer">
        SELECT max_concurrency
        FROM asts_task_type_config
        WHERE type_key = #{typeKey}
          AND is_deleted = 0
        <if test="tenantId != null">
          AND tenant_id = #{tenantId}
        </if>
        LIMIT 1
    </select>

</mapper>
