<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承本地父项目 (fun.commons.lotask4j:lotask4j-parent) -->
    <parent>
        <groupId>fun.commons.lotask4j</groupId>
        <artifactId>lotask4j-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lotask4j-backend</artifactId>
    <packaging>jar</packaging>

    <name>lotask4j 异步慢任务服务 (ASTS) - 后端服务</name>
    <description>后端 REST API 服务，处理任务的提交、查询、取消等核心业务逻辑</description>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spring Boot Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation (参数校验) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (监控端点) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== Micrometer Tracing 分布式追踪 ==================== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ==================== framework4j SDK (API、ID、DataSource、Redis、AccessToken 等) ==================== -->
        <!-- 来源：JitPack，详见 https://jitpack.io  -->
        <!-- 升级：v1.2.1 → v1.4.2 → v1.5.1。
             v1.4.2 修复 issue #18 (TransportAutoConfiguration 多 RestTemplate 注入歧义)，
             通过 ObjectProvider + 可选 rest-template-bean-name 配置实现；无破坏性变更。
             v1.5.1 实质变化仅新增 framework4j-tenant 模块 (tenant.enabled 默认 false, 不配置不生效)；
             lotask4j 在用的模块 (web/accesstoken/signature/rate-limit/idempotency/transport)
             v1.4.2 → v1.5.1 字节码零差异 (本地 m2 jar diff 验证), 升级即改版本号。 -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-all</artifactId>
            <version>v1.5.1</version>
        </dependency>

        <!-- framework4j-tenant 多租户模块 (benefit4j 同款)。
             注意: tenant 模块不在 framework4j-all 聚合中, 需显式引入。
             提供: @PlatformDomain/@TenantDomain 域守卫 + 内置 client_credentials 认证端点
             (防爆破/平台合成租户 tenant_id=0/密钥双版本宽限期/reset 撤会话) + TenantEntity 契约。
             数据隔离仍是业务表手动 tenant_id (无 SQL 拦截器), 见 documents/中间件中台租户设计.md §3.2。 -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-tenant</artifactId>
            <version>v1.5.1</version>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Druid 连接池 (v1.2.1 升级：druid-spring-boot-starter → druid-spring-boot-3-starter 1.2.28) -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.jdbc.version}</version>
        </dependency>

        <!-- Flyway 数据库迁移 (benefit4j 模式: baseline=存量 schema, 以后 DDL 演进版本化)。
             Flyway 10 起 PG 支持拆到独立 artifact, 版本随 Spring Boot BOM。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- FastJSON2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2-extension-spring6</artifactId>
        </dependency>

        <!-- Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Redis (for WorkerId allocation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- ==================== 测试依赖 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 Database (测试用内存数据库) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MyBatis Test (测试支持) -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>3.0.3</version>
            <scope>test</scope>
        </dependency>

        <!-- tenant-tck: 租户合规结构断言 (租户表契约列 / 业务表 tenant_id 索引打头 / email 唯一) -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-tenant-tck</artifactId>
            <version>v1.5.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (PostgreSQL 集成测试) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot Maven 插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Maven Surefire Plugin (测试插件) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- JaCoCo Maven Plugin (测试覆盖率) — 门禁: 核心 service 包 ≥75% 行覆盖,其他包放宽 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- 核心 service 包强门禁 -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>fun.commons.lotask4j.service.*</include>
                                        <include>fun.commons.lotask4j.schedule</include>
                                        <include>fun.commons.lotask4j.enums</include>
                                        <include>fun.commons.lotask4j.dto</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- 全局兜底: bundle 级 ≥60% (避免个别 controller 文件拖到 0%) -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
